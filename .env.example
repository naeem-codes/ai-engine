ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
DEFAULT_PROVIDER=claude
PORT=8000

RULES_REMOTE=none
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=<public anon key — identifies the project, grants nothing on its own>
#
# The engine signs in as a per-client Auth user; Supabase issues the token, which carries the
# app_metadata.client_id claim that the RLS policy enforces. Create the user (once, from your
# machine, with the service key) using:  python tools/create_client_user.py --client-id acme
# SUPABASE_EMAIL=acme@lumi-clients.local
# SUPABASE_PASSWORD=<generated by that script>
#
# SUPABASE_TOKEN=<optional: a pre-issued token used INSTEAD of signing in. Only for a dev
#                 smoke test, or a project still on the legacy shared JWT secret. Ignored
#                 when EMAIL+PASSWORD are set. Never ship a service key here — it bypasses RLS>
# CLIENT_ID=acme          # optional: read from the signed-in token's claim when omitted

# ── Rules storage ─────────────────────────────────────────────────────────────
# Live rules live OUTSIDE the shipped folder so installing a new build cannot delete them.
# Default: %PROGRAMDATA%\LumiDesignAI\rules. Override for a portable / per-user install.
# LUMI_DATA_DIR=D:\LumiDesignAI

# NOTE for client builds: none of the above needs to be present. build-release.ps1 bakes the
# configuration into ai-engine.exe (_baked.py), and any value here OVERRIDES the baked one.
# Check what a build actually received with:  GET /sync-status
